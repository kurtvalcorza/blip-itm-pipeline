     try:                                                                       
         processor=AutoProcessor.from_pretrained(str(root),local_files_only=Tru 
 e,trust_remote_code=False)                                                     
         model=AutoModel.from_pretrained(                                       
             str(root),local_files_only=True,trust_remote_code=False            
         ).to(DEVICE).eval()                                                    
                                                                                
